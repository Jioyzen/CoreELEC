+        GetGfxContext().GetVideoResolution());
+    if (!current.strId.empty() && current.strId != "dummy_l" &&
+        current.iScreenWidth > 0 && current.iScreenHeight > 0)
+      m_hotplugRestoreResolution = current;
+    const auto desktop = CDisplaySettings::GetInstance().GetResolutionInfo(RES_DESKTOP);
+    const auto setting = CServiceBroker::GetSettingsComponent()->GetSettings()->GetString(
+        CSettings::SETTING_VIDEOSCREEN_SCREENMODE);
+    if (!m_hotplugPreferredDesktop || setting != m_hotplugPreferredSetting)
+    {
+      if (!desktop.strId.empty() && desktop.strId != "dummy_l")
+        m_hotplugPreferredDesktop = desktop;
+      m_hotplugPreferredSetting = setting;
+    }
+    m_hotplugDesktopResolution = m_hotplugPreferredDesktop;
+    // A small monitor may require a temporary GUI fallback. When returning to
+    // the original sink, prefer the saved GUI timing rather than that fallback.
+    // A movie's independently selected refresh rate remains the active target.
+    if (m_hotplugPreferredDesktop && current.iScreenWidth == desktop.iScreenWidth &&
+        current.iScreenHeight == desktop.iScreenHeight &&
+        (current.dwFlags & D3DPRESENTFLAG_MODEMASK) ==
+            (desktop.dwFlags & D3DPRESENTFLAG_MODEMASK) &&
+        std::abs(current.fRefreshRate - desktop.fRefreshRate) < 0.01f)
+      m_hotplugRestoreResolution = m_hotplugPreferredDesktop;
+  }
   SetPresentationReady(false);
+
+  const auto defer = [this](unsigned int delayMs)
+  {
+    m_hotplugRetryPending = true;
+    m_hotplugRetryTimer.Set(std::chrono::milliseconds(delayMs));
+  };
+  CSysfsPath hpd{"/sys/class/amhdmitx/amhdmitx0/hpd_state"};
+  if (hpd.Get<int>().value_or(1) == 0)
+  {
+    defer(500);
+    return;
+  }
 
   try
