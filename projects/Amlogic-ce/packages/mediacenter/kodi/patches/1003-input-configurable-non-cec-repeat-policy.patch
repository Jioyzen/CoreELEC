Subject: [PATCH] input: configurable repeat policy for non-CEC remote inputs

Use one optional environment policy for libinput keyboard and LIRC repeat
paths. Preserve legacy behavior when unconfigured, exclude CEC inputs, and
refresh cached settings on device reconnection.

--- a/xbmc/platform/linux/input/LibInputKeyboard.cpp
+++ b/xbmc/platform/linux/input/LibInputKeyboard.cpp
@@ -7,6 +7,7 @@
  */
 
 #include "LibInputKeyboard.h"
+#include "RemoteRepeatPolicy.h"
 
 #include "EvdevKeyMapping.h"
 #include "LangInfo.h"
@@ -604,13 +605,23 @@
     close(fd);
   }
 
+  const auto policy = KODI::INPUT::GetRemoteRepeatPolicy();
+  const bool isCec = KODI::INPUT::IsCecInput(name ? name : "") ||
+                     (libinput_device_get_id_vendor(dev) == 0x1b8e &&
+                      libinput_device_get_id_product(dev) == 0x0cec);
+  if (policy && !isCec)
+  {
+    kbdrep[0] = policy->delayMs;
+    kbdrep[1] = policy->periodMs;
+    CLog::Log(LOGDEBUG, "CLibInputKeyboard::{} - remote repeat policy: {}ms/{}ms for {} ({})",
+              __FUNCTION__, kbdrep[0], kbdrep[1], name, sysname);
+  }
+
   std::vector<int> kbdrepvec(std::begin(kbdrep), std::end(kbdrep));
 
-  auto data = m_repeatData.find(dev);
-  if (data == m_repeatData.end())
-  {
-    m_repeatData.insert(std::make_pair(dev, kbdrepvec));
-  }
+  // A newly connected device can reuse an old libinput pointer. Refresh its
+  // current settings rather than retaining another device's cached repeat rate.
+  m_repeatData.insert_or_assign(dev, std::move(kbdrepvec));
 }
 
