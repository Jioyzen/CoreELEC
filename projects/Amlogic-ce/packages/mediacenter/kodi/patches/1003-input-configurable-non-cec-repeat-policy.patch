--- /dev/null
+++ b/xbmc/platform/linux/input/RemoteRepeatPolicy.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <charconv>
+#include <chrono>
+#include <cstdlib>
+#include <optional>
+#include <string_view>
+
+namespace KODI::INPUT
+{
+struct RemoteRepeatPolicy
+{
+  int delayMs;
+  int periodMs;
+};
+
+inline std::optional<int> ReadRepeatValue(const char* name, int minimum, int maximum)
+{
+  const char* value = std::getenv(name);
+  if (!value)
+    return std::nullopt;
+  const std::string_view text{value};
+  int result = 0;
+  const auto parsed = std::from_chars(text.data(), text.data() + text.size(), result);
+  if (parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size() || result < minimum ||
+      result > maximum)
+    return std::nullopt;
+  return result;
+}
+
+inline std::optional<RemoteRepeatPolicy> GetRemoteRepeatPolicy()
+{
+  static const auto policy = []() -> std::optional<RemoteRepeatPolicy>
+  {
+    const auto period = ReadRepeatValue("KODI_REMOTE_REPEAT_PERIOD_MS", 50, 5000);
+    if (!period)
+      return std::nullopt;
+    const auto delay = ReadRepeatValue("KODI_REMOTE_REPEAT_DELAY_MS", 0, 5000);
+    return RemoteRepeatPolicy{delay.value_or(500), *period};
+  }();
+  return policy;
+}
+
+inline bool IsCecInput(std::string_view name)
+{
+  const auto lower = [](char c) { return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c; };
+  for (size_t i = 0; i + 2 < name.size(); ++i)
+  {
+    if (lower(name[i]) == 'c' && lower(name[i + 1]) == 'e' && lower(name[i + 2]) == 'c')
+      return true;
+  }
+  return false;
+}
+
+inline bool RemoteRepeatDue(std::chrono::steady_clock::time_point first,
+                            std::chrono::steady_clock::time_point last,
+                            std::chrono::steady_clock::time_point now,
+                            const RemoteRepeatPolicy& policy)
+{
+  // Accept nominal repeat periods with a little scheduling jitter, rather than
+  // dropping alternate events whose measured spacing is just under the target.
+  constexpr auto tolerance = std::chrono::milliseconds{5};
+  return now - first + tolerance >= std::chrono::milliseconds{policy.delayMs} &&
+         now - last + tolerance >= std::chrono::milliseconds{policy.periodMs};
+}
+} // namespace KODI::INPUT
