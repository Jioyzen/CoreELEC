[Unit]
Description=First-desktop Wi-Fi connection wizard
After=kodi.service jioyzen-media-activate.service
Requires=kodi.service
ConditionPathExists=!/storage/.cache/jioyzen-media/wifi-setup.json
[Service]
Type=oneshot
ExecStart=/usr/lib/jioyzen-media/wifi/start.sh
TimeoutStartSec=130
[Install]
WantedBy=kodi.target
