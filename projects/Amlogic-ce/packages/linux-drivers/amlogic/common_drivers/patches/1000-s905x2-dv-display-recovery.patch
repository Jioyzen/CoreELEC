+/* Unlike is_codec_mm_kept(), this also accepts a scatter handle. */
+int codec_mm_keeper_mem_is_pinned(void *mem_handle)
+{
+	struct codec_mm_keeper_mgr *mgr = get_codec_mm_keeper_mgr();
+	unsigned long flags;
+	int i, found = 0;
+
+	if (!mem_handle)
+		return 0;
+	spin_lock_irqsave(&mgr->lock, flags);
+	for (i = 0; i < MAX_KEEP_FRAME; i++) {
+		if (mgr->keep_list[i].handle == mem_handle) {
+			found = 1;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&mgr->lock, flags);
+	return found;
+}
+
 int is_codec_mm_kept(void *mem_handle)
