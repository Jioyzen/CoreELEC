Subject: [PATCH] meson-ir: safely grow input devices and reuse devices on map reload

Userspace loading two NEC maps wrote past a one-pointer allocation. Reloading
an existing map also increased input_dev_num without adding a device. The next
key press could dereference a NULL/out-of-bounds slot in meson_ir_keydown and
panic in interrupt context. Prepare a correctly sized array for each new input,
publish it under keylock, and keep IDs/count stable for replacement maps.
Configure input capabilities before registration so hot-added maps are visible
to udev/libinput. Keep the old map if allocation or registration fails.

--- a/drivers/input/ir/meson_ir_cdev.c
+++ b/drivers/input/ir/meson_ir_cdev.c
@@ -7,28 +7,107 @@
 #include <linux/module.h>
 #include <linux/init.h>
 #include <linux/types.h>
 #include <linux/uaccess.h>
 #include <linux/slab.h>
 #include <linux/list.h>
 #include <linux/fs.h>
 #include <linux/interrupt.h>
+#include <linux/string.h>
 #include "meson_ir_main.h"
 #include "meson_ir_sysfs.h"
+
+MODULE_INFO(ir_map_layout, "bounded-v1");
+
+/* file_lock serializes map writers; keylock protects IRQ/timer readers. */
+static int meson_ir_setup_map_input(struct meson_ir_chip *chip,
+				   struct meson_ir_map_tab_list *map,
+				   struct meson_ir_map_tab_list *old_map)
+{
+	struct meson_ir_dev *dev = chip->r_dev;
+	struct input_dev *input_device = NULL;
+	struct input_dev **devices, **old_devices;
+	unsigned int index = dev->input_dev_num;
+	unsigned long flags;
+	const char *name;
+	int ret;
+
+	if (old_map)
+		input_device = meson_ir_match_input_dev(dev, old_map);
+	if (input_device) {
+		/* Replacing a map must not add another device or change its ID. */
+		map->tab.id = input_device->id;
+		strscpy(map->tab.custom_name, input_device->name, CUSTOM_NAME_LEN);
+		return 0;
+	}
+
+	devices = kmalloc_array(index + 1, sizeof(*devices), GFP_KERNEL);
+	if (!devices)
+		return -ENOMEM;
+	if (index)
+		memcpy(devices, dev->input_devs, index * sizeof(*devices));
+
+	input_device = devm_input_allocate_device(chip->dev);
+	if (!input_device) {
+		ret = -ENOMEM;
+		goto free_devices;
+	}
+	name = devm_kasprintf(chip->dev, GFP_KERNEL, "ir_keypad%d_%d",
+			     chip->dev_no, index);
+	if (!name) {
+		ret = -ENOMEM;
+		goto free_devices;
+	}
+
+	input_device->name = name;
+	input_device->phys = "keypad/input0";
+	input_device->dev.parent = chip->dev;
+	input_device->id.vendor = 0x0001;
+	input_device->id.product = index + 1;
+	input_device->id.version = 0x0100;
+	input_device->id.bustype = BUS_ISA;
+	input_device->rep[REP_DELAY] = 0xffffffff;
+	input_device->rep[REP_PERIOD] = 0xffffffff;
+	input_set_drvdata(input_device, dev);
+	/* udev/libinput must see the final capabilities at registration. */
+	meson_ir_input_configure(input_device, NULL);
+	ret = input_register_device(input_device);
+	if (ret)
+		goto free_devices;
+
+	devices[index] = input_device;
+	spin_lock_irqsave(&dev->keylock, flags);
+	old_devices = dev->input_devs;
+	dev->input_devs = devices;
+	dev->input_dev_num = index + 1;
+	spin_unlock_irqrestore(&dev->keylock, flags);
+	kfree(old_devices);
+
+	map->tab.id = input_device->id;
+	strscpy(map->tab.custom_name, name, CUSTOM_NAME_LEN);
+	return 0;
+
+free_devices:
+	kfree(devices);
+	return ret;
+}
 
 static int meson_ir_open(struct inode *inode, struct file *file)
 {
 	struct meson_ir_chip *chip;
 
 	chip = container_of(inode->i_cdev, struct meson_ir_chip, chrdev);
 	file->private_data = chip;
 	disable_irq(chip->irqno[0]);
 	if (chip->irqno[1] >= 0)
 		disable_irq(chip->irqno[1]);
+	/* Drain hardware decode and key-up readers before replacing maps. */
+	tasklet_disable(&chip->tasklet);
+	del_timer_sync(&chip->r_dev->timer_keyup);
 	return 0;
 }
 
