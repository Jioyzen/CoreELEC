-			ir_map->tab.id.vendor = 0x0001;
-			ir_map->tab.id.product = current_index + 1;
-			ir_map->tab.id.version = 0x0100;
-			ir_map->tab.id.bustype = BUS_ISA;
-			memcpy(ir_map->tab.custom_name, input_device->name,
